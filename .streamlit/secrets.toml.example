# Copy this file to .streamlit/secrets.toml for local testing (that file is
# gitignored — never commit your real key), or paste the same line into the
# "Secrets" box when deploying on Streamlit Community Cloud.

FRED_API_KEY = "your_fred_api_key_here"
BEA_API_KEY = "your_bea_api_key_here"  # optional, for the BEA tab: https://apps.bea.gov/API/signup/
CENSUS_API_KEY = "your_census_api_key_here"  # optional, for the Census tab: https://api.census.gov/data/key_signup.html
BLS_API_KEY = "your_bls_api_key_here"  # optional, raises BLS limits: https://data.bls.gov/registrationEngine/
